# PBS protection configuration
# Installed as /etc/pbs-protection/pbs-protection.env (mode 0600).

# Local PBS datastore
PBS_DATASTORE="pbs-sas"
PBS_DATASTORE_PATH="/mnt/datastore/pbs-sas"
PBS_DATASTORE_UUID="4dfb9891-5d22-43da-81ad-cc91d48635d1"

# Dedicated local audit token created by install.sh.
PBS_REPOSITORY="pbs-protection@pbs!reader@localhost:pbs-sas"
PBS_PASSWORD_FILE="/etc/pbs-protection/reader-token.secret"
PBS_FINGERPRINT="auto"
PBS_CERT_FILE="/etc/proxmox-backup/proxy.pem"

# Explicit promotion policy. The cycle refuses to run until reviewed=true.
EXPECTED_BACKUPS_FILE="/etc/pbs-protection/expected-backups.json"
PBS_NAMESPACES="r630 nuc-pve beelink-pve mini-pve"
DEFAULT_MAX_AGE_HOURS_CONFIG=36

# Passed-through Hitachi SAS datastore disk.
SMART_DEVICE="/dev/disk/by-id/scsi-35000cca01bcb87ac"
SMART_MAX_GROWN_DEFECTS=0
SMART_MAX_NON_MEDIUM_ERRORS=0
SMART_MAX_UNCORRECTED_ERRORS=0
SMART_WARN_TEMP_C=48
SMART_FAIL_TEMP_C=55
KERNEL_ERROR_LOOKBACK_HOURS=36

# NAS exported from the NUC. The underlying USB disk is ext4; from PBS this is
# normally NFS/NFS4. With x-systemd.automount, findmnt may report the autofs
# trigger layer first; the preflight write probe still forces and validates the
# backing NFS mount.
NAS_MOUNT="/mnt/nas/pbs-mirror"
NAS_EXPECTED_FSTYPE_REGEX='^(autofs|nfs|nfs4)$'
NAS_DEST="/mnt/nas/pbs-mirror/pbs-mini/pbs-sas"
NAS_PROMOTION_MARKER="/mnt/nas/pbs-mirror/pbs-mini/promotion.json"
NAS_CHECK_MODE="size-only"

# Low-cost, unversioned S3 mirror. S3 is sourced from the verified NAS mirror.
RCLONE_CONF="/root/.config/rclone/rclone.conf"
S3_DEST="amazon_s3_backup:welshembassy-general-purpose/backups/pbs/pbs-mini/pbs-sas"
S3_PROMOTION_MARKER="amazon_s3_backup:welshembassy-general-purpose/backups/pbs/pbs-mini/promotion.json"
S3_CHECK_ENABLED=1
S3_CHECK_MODE="size-only"

# Small, non-secret configuration archives. These do not include passwords,
# token secrets, rclone credentials, Telegram credentials or PBS private keys.
CONFIG_ARCHIVE_ENABLED=1
NAS_CONFIG_DEST="/mnt/nas/pbs-mirror/pbs-mini/config-history"
S3_CONFIG_DEST="amazon_s3_backup:welshembassy-general-purpose/backups/pbs/pbs-mini/config-history"
CONFIG_ARCHIVE_KEEP_LOCAL=30
CONFIG_ARCHIVE_KEEP_NAS=30

# Rclone tuning. Conservative defaults for a small PBS/NAS environment.
RCLONE_TRANSFERS=8
RCLONE_CHECKERS=16
RCLONE_RETRIES=5
RCLONE_LOW_LEVEL_RETRIES=10
RCLONE_CONTIMEOUT="30s"
RCLONE_TIMEOUT="1h"
RCLONE_STATS_INTERVAL="60s"

# Verification jobs are installed without native schedules; systemd invokes them.
PROMOTION_VERIFY_JOB="pbs-sas-promotion"
MONTHLY_VERIFY_JOB="pbs-sas-monthly-full"
VERIFY_TIMEOUT_SEC=86400
MONTHLY_VERIFY_TIMEOUT_SEC=259200
PBS_IDLE_TIMEOUT_SEC=7200
PBS_IDLE_POLL_SEC=15

# Post-promotion maintenance. Leave PRUNE_JOB_IDS empty until retention jobs have
# been reviewed/created. GC runs only after a successful NAS+S3 promotion.
PRUNE_JOB_IDS=""
GC_ENABLED=1
GC_WEEKDAY=7

# Optional Telegram reporting.
TELEGRAM_ENABLE=1
TELEGRAM_SEND_BIN="/usr/bin/telegram-send"
TELEGRAM_CFG="/root/.config/telegram-send.conf"

STATE_DIR="/var/lib/pbs-protection"
LOG_DIR="/var/log/pbs-protection"
LOCK_FILE="/run/lock/pbs-protection-cycle.lock"
